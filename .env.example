APP_NAME=BarberCuts
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
APP_FAKER_LOCALE=nl_NL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=barbercuts
DB_USERNAME=root
DB_PASSWORD=

# Productie en CI: redis. Lokaal zonder Redis: database.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hallo@barbercuts.nl"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# BarberCuts
BILLING_ENABLED=false
FEATURE_DEPOSITS=false
SMS_PROVIDER=log
WHATSAPP_PROVIDER=log
FEATURE_SMS=false
FEATURE_WHATSAPP=false
# Kosten per bericht in eurocenten (voor de statistiek in /admin)
SMS_COST_CENTS=8
WHATSAPP_COST_CENTS=6

# Web push (fase 5). Maak sleutels met: php artisan webpush:vapid  (eenmalig; wissel ze daarna nooit, dan verlopen alle abonnementen)
VAPID_SUBJECT="mailto:hallo@barbercuts.nl"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Twilio, alleen nodig met SMS_PROVIDER=twilio of WHATSAPP_PROVIDER=twilio
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# Content SID's van de door Meta goedgekeurde WhatsApp-templates (4 variabelen: naam, zaak, tijdstip, beheerlink)
WHATSAPP_TEMPLATE_CONFIRMATION=
WHATSAPP_TEMPLATE_REMINDER=
WHATSAPP_TEMPLATE_RESCHEDULED=
WHATSAPP_TEMPLATE_CANCELLED=

# Mollie (abonnementen). Gebruik eerst een test_-sleutel; facturering staat uit zolang BILLING_ENABLED=false
# of zolang het in /admin → Instellingen niet is aangezet.
MOLLIE_KEY=

# Bedrijfsgegevens voor de privacyverklaring, voorwaarden en contactpagina (lege velden worden weggelaten)
COMPANY_NAME="BarberCuts"
COMPANY_KVK=
COMPANY_VAT=
COMPANY_ADDRESS=
COMPANY_EMAIL="hallo@barbercuts.nl"
COMPANY_PHONE=


# Fase 6–9 (allemaal optioneel; dit zijn de standaardwaarden)
# Uren dat een demozaak van een pitcher blijft staan
DEMO_HOURS=24
# Adressen omzetten naar coördinaten via PDOK, voor "kappers in de buurt"
GEOCODING_ENABLED=true
# Alleen nodig als WhatsApp aan staat: template voor het reviewverzoek
WHATSAPP_TEMPLATE_REVIEW_REQUEST=
